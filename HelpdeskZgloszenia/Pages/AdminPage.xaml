<Page
    x:Class="HelpdeskZgloszenia.Pages.AdminPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HelpdeskZgloszenia.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AdminPage"
    d:DesignHeight="650"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <StackPanel
                Grid.Column="0"
                Background="White"
                Orientation="Vertical">
                <StackPanel Margin="5" Orientation="Vertical">
                    <TextBlock
                        FontSize="25"
                        FontWeight="bold"
                        Foreground="#0A7BFF"
                        Text="HelpDesk IT"
                        TextAlignment="Center" />
                    <TextBlock
                        FontSize="10"
                        FontWeight="Light"
                        Foreground="#0A7BFF"
                        Text="Admin Panel"
                        TextAlignment="Center" />
                </StackPanel>
                <Button
                    x:Name="BtnDashboard"
                    HorizontalContentAlignment="Left"
                    Background="White"
                    BorderThickness="0"
                    Click="BtnDashboard_Click">
                    <StackPanel Margin="15,0,0,0" Orientation="Horizontal">
                        <Viewbox
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center">
                            <Path Data="{StaticResource dashboard}" Fill="#0A7BFF" />
                        </Viewbox>

                        <TextBlock
                            Padding="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="15"
                            Foreground="#0A7BFF"
                            Text="Dashboard" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="BtnReports"
                    HorizontalContentAlignment="Left"
                    Background="White"
                    BorderThickness="0"
                    Click="BtnReports_Click">
                    <StackPanel Margin="15,0,0,0" Orientation="Horizontal">
                        <Viewbox
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center">
                            <Path Data="{StaticResource reports}" Fill="#0A7BFF" />
                        </Viewbox>

                        <TextBlock
                            Padding="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="15"
                            Foreground="#0A7BFF"
                            Text="Reports" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="BtnWorkers"
                    HorizontalContentAlignment="Left"
                    Background="White"
                    BorderThickness="0"
                    Click="BtnWorkers_Click">
                    <StackPanel Margin="15,0,0,0" Orientation="Horizontal">
                        <Viewbox
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center">
                            <Path Data="{StaticResource users}" Fill="#0A7BFF" />
                        </Viewbox>

                        <TextBlock
                            Padding="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="15"
                            Foreground="#0A7BFF"
                            Text="Workers" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="BtnStats"
                    HorizontalContentAlignment="Left"
                    Background="White"
                    BorderThickness="0"
                    Click="BtnStats_Click">
                    <StackPanel Margin="15,0,0,0" Orientation="Horizontal">
                        <Viewbox
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center">
                            <Path Data="{StaticResource stats}" Fill="#0A7BFF" />
                        </Viewbox>

                        <TextBlock
                            Padding="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="15"
                            Foreground="#0A7BFF"
                            Text="Statistics" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel
                Grid.Row="1"
                Margin="10"
                HorizontalAlignment="Stretch"
                Orientation="Vertical">
                <TextBlock Foreground="#0A7BFF" Text="Logged as:" />
                <TextBlock
                    x:Name="LoginName"
                    FontWeight="Bold"
                    Foreground="#0A7BFF"
                    TextAlignment="Center" />
                <Button
                    x:Name="BtnLogout"
                    Margin="5"
                    Padding="5"
                    Background="#0A7BFF"
                    BorderThickness="0"
                    Click="BtnLogout_Click"
                    Content="Log out"
                    FontSize="15"
                    Foreground="White" />
            </StackPanel>
        </Grid>
        <Frame
            Name="AdminPageContent"
            Grid.Column="1"
            NavigationUIVisibility="Hidden"
            Source="Admin/Dashboard.xaml" />
    </Grid>
</Page>
