<Page
    x:Class="HelpdeskZgloszenia.Pages.Admin.Workers"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HelpdeskZgloszenia.Pages.Admin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Workers"
    d:DesignHeight="650"
    d:DesignWidth="640"
    mc:Ignorable="d">

    <StackPanel Background="#f0f0f0" Orientation="Vertical">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Viewbox
                Grid.Column="0"
                Width="40"
                Height="40"
                Margin="20,10"
                VerticalAlignment="Center">
                <Path Data="{StaticResource users}" Fill="#0A7BFF" />
            </Viewbox>
            <TextBlock
                Grid.Column="1"
                Padding="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="45"
                FontWeight="Bold"
                Foreground="#0A7BFF"
                Text="Workers" />
            <TextBlock
                x:Name="TxtClock"
                Grid.Column="2"
                Padding="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="25"
                FontWeight="Bold"
                Foreground="#0A7BFF"
                Text="00:00" />
        </Grid>
        <DataGrid
            x:Name="GridWorkers"
            CellStyle="{StaticResource ModernCell}"
            ColumnHeaderStyle="{StaticResource ModernColumnHeader}"
            IsReadOnly="True"
            ItemsSource="{Binding ReportsList}"
            Style="{StaticResource ModernDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="40"
                    Binding="{Binding Id}"
                    Header="ID" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Name}"
                    Header="Name" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding LastName}"
                    Header="Last Name" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Position}"
                    Header="Position" />
                <DataGridTextColumn
                    Width="2*"
                    Binding="{Binding Email}"
                    Header="Email" />
            </DataGrid.Columns>

        </DataGrid>
    </StackPanel>
</Page>
