<Page
    x:Class="HelpdeskZgloszenia.Pages.Admin.Reports"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HelpdeskZgloszenia.Pages.Admin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Reports"
    d:DesignHeight="650"
    d:DesignWidth="640"
    mc:Ignorable="d">

    <StackPanel Background="#f0f0f0" Orientation="Vertical">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Viewbox
                Grid.Column="0"
                Width="40"
                Height="40"
                Margin="10"
                VerticalAlignment="Center">
                <Path Data="{StaticResource reports}" Fill="#0A7BFF" />
            </Viewbox>
            <TextBlock
                Grid.Column="1"
                Padding="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="45"
                FontWeight="Bold"
                Foreground="#0A7BFF"
                Text="Reports" />
        </Grid>
        <DataGrid
            x:Name="GridReports"
            CellStyle="{StaticResource ModernCell}"
            ColumnHeaderStyle="{StaticResource ModernColumnHeader}"
            IsReadOnly="True"
            ItemsSource="{Binding ReportsList}"
            Style="{StaticResource ModernDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="40"
                    Binding="{Binding Id}"
                    Header="ID" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Title}"
                    Header="Title" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding ReportedBy}"
                    Header="Reported by" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding ModeratedBy}"
                    Header="Moderated by" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding State}"
                    Header="Status" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding ReportDate}"
                    Header="Date of Report" />

            </DataGrid.Columns>

        </DataGrid>
    </StackPanel>
</Page>
