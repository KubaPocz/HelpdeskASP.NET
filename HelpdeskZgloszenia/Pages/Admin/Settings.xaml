<Page
    x:Class="HelpdeskZgloszenia.Pages.Admin.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HelpdeskZgloszenia.Pages.Admin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Settings"
    d:DesignHeight="650"
    d:DesignWidth="640"
    mc:Ignorable="d">

    <StackPanel Background="#f0f0f0" Orientation="Vertical">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Viewbox
                Grid.Column="0"
                Width="40"
                Height="40"
                Margin="10"
                VerticalAlignment="Center">
                <Path Data="{StaticResource settings}" Fill="#0A7BFF" />
            </Viewbox>
            <TextBlock
                Grid.Column="1"
                Padding="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="45"
                FontWeight="Bold"
                Foreground="#0A7BFF"
                Text="Settings" />
        </Grid>
    </StackPanel>
</Page>
